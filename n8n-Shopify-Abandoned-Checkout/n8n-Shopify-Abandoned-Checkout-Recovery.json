        "openAiApi": { "id": "YOUR_OPENAI_CREDENTIAL_ID", "name": "OpenAI" }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Update State for Re-Evaluation').first().json;\nconst evalRaw = $input.first().json.message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(evalRaw);\n} catch(e) {\n  parsed = { score: 7, suggestion: '' };\n}\n\nconst passesThreshold = parsed.score >= 7;\nconst hitMaxAttempts = prev.attemptCount >= 3;\n\nreturn [{\n  json: {\n    ...prev,\n    persuasionScore: parsed.score,\n    suggestion: parsed.suggestion,\n    passesThreshold,\n    hitMaxAttempts,\n    shouldSend: passesThreshold || hitMaxAttempts\n  }\n}];"
      },
      "id": "parse-re-eval",
      "name": "Parse Re-Evaluation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
