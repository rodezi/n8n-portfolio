      }
    },
    {
      "parameters": {
        "jsCode": "// Merge final message from either path (first attempt pass OR retry path)\nlet data;\ntry {\n  data = $('Parse Evaluation & Check Threshold').first().json;\n} catch(e) {\n  data = $('Parse Re-Evaluation').first().json;\n}\n\nreturn [{ json: data }];"
      },
      "id": "merge-final",
