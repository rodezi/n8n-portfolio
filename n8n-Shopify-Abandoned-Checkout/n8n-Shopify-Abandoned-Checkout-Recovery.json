        "model": { "__rl": true, "value": "gpt-4o", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a friendly and knowledgeable beauty advisor for an eBeauty brand. Your job is to write warm, helpful, and personal abandoned cart recovery messages. Write in a single flowing paragraph without line breaks. The tone should be warm, expert, and non-pushy. Use the customer's name if available, mention specific cart items, include the total price, any discount code, and always include the recovery link."
            },
            {
              "role": "user",
              "content": "=Rewrite this abandoned cart recovery message incorporating the following improvement:\n\nPrevious message:\n{{ $json.generatedMessage }}\n\nImprovement suggestion:\n{{ $json.suggestion }}\n\nCustomer name: {{ $json.customerFirstName || 'there' }}\nCart items: {{ $json.lineItemsSummary }}\nTotal: {{ $json.currency }} {{ $json.totalPrice }}\nDiscount code: {{ $json.discountCodes.length > 0 ? $json.discountCodes.join(', ') : 'None' }}\nRecovery link: {{ $json.recoveryUrl }}"
            }
          ]
        },
        "options": { "temperature": 0.7 }
      },
      "id": "retry-message",
      "name": "GPT-4o: Rewrite with Feedback",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [3320, 520],
      "credentials": {
        "openAiApi": { "id": "YOUR_OPENAI_CREDENTIAL_ID", "name": "OpenAI" }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Parse Evaluation & Check Threshold').first().json;\nconst newMessage = $input.first().json.message.content;\n\nreturn [{\n  json: {\n    ...prev,\n    generatedMessage: newMessage,\n    attemptCount: prev.attemptCount + 1,\n    lastSuggestion: prev.suggestion\n  }\n}];"
      },
      "id": "update-for-retry",
      "name": "Update State for Re-Evaluation",
