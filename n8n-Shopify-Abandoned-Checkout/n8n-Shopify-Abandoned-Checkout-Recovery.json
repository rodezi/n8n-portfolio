    {
      "parameters": {
        "method": "POST",
        "url": "=https://a.klaviyo.com/api/events/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Klaviyo-API-Key {{ $vars.KLAVIYO_PRIVATE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "revision", "value": "2024-02-15" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"data\": {\n    \"type\": \"event\",\n    \"attributes\": {\n      \"metric\": {\n        \"data\": {\n          \"type\": \"metric\",\n          \"attributes\": {\n            \"name\": \"AI Recovery Email Sent\"\n          }\n        }\n      },\n      \"profile\": {\n        \"data\": {\n          \"type\": \"profile\",\n          \"attributes\": {\n            \"email\": \"{{ $json.customerEmail }}\"\n          }\n        }\n      },\n      \"properties\": {\n        \"email_message\": \"{{ $json.generatedMessage }}\",\n        \"persuasion_score\": {{ $json.persuasionScore }},\n        \"checkout_id\": \"{{ $json.checkoutId }}\",\n        \"total_price\": \"{{ $json.totalPrice }}\",\n        \"currency\": \"{{ $json.currency }}\",\n        \"line_items\": \"{{ $json.lineItemsSummary }}\",\n        \"recovery_url\": \"{{ $json.recoveryUrl }}\",\n        \"attempt_count\": {{ $json.attemptCount }}\n      },\n      \"time\": \"{{ $now.toISO() }}\"\n    }\n  }\n}"
      },
