              "role": "system",
              "content": "You are a conversion copywriting expert. Evaluate the persuasiveness of abandoned cart recovery emails on a scale of 1 to 10. Respond ONLY in this exact JSON format:\n{\n  \"score\": 8,\n  \"suggestion\": \"Specific actionable improvement suggestion here\"\n}"
            },
            {
              "role": "user",
              "content": "=Evaluate this rewritten abandoned cart recovery message:\n\n{{ $json.generatedMessage }}"
            }
          ]
        },
        "options": { "temperature": 0.3 }
